+// AirBridge: tell the display what the untouched video plane carries. The GPU
+// renderer never sees these frames, so nothing else signals their colour.
+static void signal_video_color(struct ra_hwdec *hw, struct mp_image *hw_image,
+                               drmModeAtomicReq *request)
+{
+    struct priv *p = hw->priv;
+    struct vo *vo = hw->ra_ctx ? hw->ra_ctx->vo : NULL;
+
+    if (hw_image && request) {
+        // Standard DRM enum values: 0 BT.601, 1 BT.709, 2 BT.2020; 0 limited, 1 full.
+        uint64_t encoding = 1;
+        switch (hw_image->params.repr.sys) {
+        case PL_COLOR_SYSTEM_BT_601:    encoding = 0; break;
+        case PL_COLOR_SYSTEM_BT_2020_NC:
+        case PL_COLOR_SYSTEM_BT_2020_C: encoding = 2; break;
+        default: break;
+        }
+        uint64_t range = hw_image->params.repr.levels == PL_COLOR_LEVELS_FULL ? 1 : 0;
+        // Optional properties: a plane without them simply keeps its default.
+        drm_object_set_property(request, p->ctx->drmprime_video_plane, "COLOR_ENCODING", encoding);
+        drm_object_set_property(request, p->ctx->drmprime_video_plane, "COLOR_RANGE", range);
+    }
+
+    if (!vo || !vo->drm)
+        return;
+
+    struct pl_color_space color = pl_color_space_srgb;
+    if (hw_image && pl_color_space_is_hdr(&hw_image->params.color)) {
+        // Static metadata only: per-frame dynamic values would change the
+        // signalled colour space, and so reconfigure the output, on every frame.
+        const struct pl_color_space *in = &hw_image->params.color;
+        color = (struct pl_color_space) {
+            .primaries = in->primaries,
+            .transfer = in->transfer,
+            .hdr = {
+                .prim = in->hdr.prim,
+                .min_luma = in->hdr.min_luma,
+                .max_luma = in->hdr.max_luma,
+                .max_cll = in->hdr.max_cll,
+                .max_fall = in->hdr.max_fall,
+            },
+        };
+    }
+    vo_drm_set_color(vo, &color);
+}
