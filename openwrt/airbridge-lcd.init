#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
    [ -c /dev/spidev0.0 ] || {
        logger -t airbridge-lcd "SPI0 missing; display service not started"
        return 1
    }
    procd_open_instance telemetry
    procd_set_param command /bin/sh /usr/libexec/airbridge-lcd-telemetry --loop
    procd_set_param respawn 3600 5 5
    procd_set_param stderr 1
    procd_close_instance

    procd_open_instance display
    procd_set_param command /usr/bin/airbridge-lcd --device /dev/spidev0.0 \
        --rotation 90 --geometry 320x240 --speed 1000000
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
