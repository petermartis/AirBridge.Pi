#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled root nice
	config_load airbridge-media
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get root main root /mnt/media
	config_get nice main nice 5
	case "$nice" in [0-9]|1[0-9]) ;; *) nice=5 ;; esac
	# No shell evaluation, command strings, extra player arguments or URLs.
	case "$root" in /*) ;; *) return 1 ;; esac
	umask 077
	mkdir -p /var/run/airbridge-media || return 1
	chmod 0700 /var/run/airbridge-media || return 1

	# Root is a deliberate diagnostic default until actual DRM/ALSA device
	# permissions permit a dedicated shared UID. Never change device ACLs here.
	procd_open_instance player
	procd_set_param command /usr/libexec/airbridge-media-player
	procd_set_param nice "$nice"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance controller
	procd_set_param command /usr/sbin/airbridge-media-controller "$root"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger airbridge-media
}
